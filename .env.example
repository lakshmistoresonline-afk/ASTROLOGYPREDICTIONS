# Jyotish OS Environment Template (V1.0.0)

# Mandatory: Secret for session signing. Generate a random 64-char hex string.
FLASK_SECRET_KEY=CHANGE_ME_TO_RANDOM_HEX

# Database URL: Local SQLite by default.
# SQLALCHEMY_DATABASE_URI=sqlite:///D:/ASTROLOGYPREDICTIONS/data/app.db

# Calculation Service Endpoint (Isolated Swiss Ephemeris)
CALC_SERVICE_URL=http://localhost:8000

